{
  "name": "foodtruck-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend acadêmico do FoodTruck — cardápio via QR Code",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test tests/persistence.test.mjs tests/services.test.mjs tests/http.test.mjs tests/qrcode.test.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
