# Opcional: copie para .env e inicie com node --env-file=.env dist/server.js.
# npm start e npm run dev leem o ambiente do processo, sem carregar .env automaticamente.
PORT=8080
DATABASE_PATH=data/foodtruck.sqlite
# Página pública a ser fornecida pelo frontend. No celular, use o IPv4 do computador.
CARDAPIO_URL=http://localhost:8080/cardapio.html
